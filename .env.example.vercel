# ------------------------------------------------------------------
# Couchtime on Vercel
#
# Vercel does NOT read a .env file from your repository. Instead:
#   1. Fill in the values below. Keep your real copy private and never commit it.
#   2. On vercel.com open your project > Settings > Environment Variables.
#   3. Import this file or paste its lines there.
#   4. Redeploy, then open https://YOUR-APP.vercel.app/api/health
#      It should show "problems": []
# ------------------------------------------------------------------

APP_NAME=Couchtime

# --- Database: MongoDB Atlas (free cluster) ------------------------
# Keep "/couchtime" (the database name) right before the "?".
# If the password contains symbols such as @ # / : write them as % codes, or pick a simpler password.
# In Atlas > Network Access allow 0.0.0.0/0, because Vercel's addresses change.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/couchtime?retryWrites=true&w=majority

# --- Sessions (required) -------------------------------------------
# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later logs everyone out.
JWT_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE

# --- Realtime: Ably (free) -----------------------------------------
# Vercel cannot hold WebSockets, so rooms use Ably.
# Create a key in the Ably dashboard > API Keys with the capabilities
#   publish, subscribe, presence
# restricted to the channels
#   room:*,sig:*
# and paste the whole key (it looks like xxxxxx.yyyyyy:zzzzzzzz).
# Do NOT use the "Subscribe only" key: it cannot publish, so nothing would reach other people.
REALTIME_DRIVER=ably
ABLY_API_KEY=PASTE_ABLY_KEY_HERE

# --- Voice, camera and screen share: TURN (optional) ---------------
# Calls work for most people with the built-in free STUN servers. TURN is for people on strict
# networks (some mobile data, office Wi-Fi). Pick ONE option and remove the # from its lines.
#
# Option A: Metered. Sign up at metered.ca (no credit card). Allowance: the Open Relay page says
# 20 GB a month, the pricing page lists 500 MB, so check your dashboard.
# TURN_PROVIDER=metered
# METERED_APP=yourappname
# METERED_API_KEY=PASTE_METERED_KEY_HERE
#
# Option B: ExpressTURN. Sign up at expressturn.com (free plan: 1,000 GB a month, port 3478 only).
# Copy the username and password from its dashboard.
# TURN_PROVIDER=static
# TURN_URLS=turn:free.expressturn.com:3478?transport=udp,turn:free.expressturn.com:3478?transport=tcp
# TURN_USERNAME=PASTE_USERNAME_HERE
# TURN_CREDENTIAL=PASTE_PASSWORD_HERE

# --- Optional tuning (these are the defaults) ----------------------
# ROOM_IDLE_HOURS=24
# CHAT_KEEP_DAYS=7
