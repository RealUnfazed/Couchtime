# ------------------------------------------------------------------
# Copy this file to .env for local development.
# On Vercel, use .env.example.vercel instead: add its names under Project > Settings > Environment Variables.
# ------------------------------------------------------------------

APP_NAME=Couchtime
PORT=3000

# --- Database --------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/couchtime   (docker compose up -d starts one)
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/couchtime?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/couchtime

# --- Sessions (REQUIRED in production) -------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Realtime --------------------------------------------------------
# socketio = built-in WebSockets (default locally, VPS, Render, Railway...)
# ably     = hosted realtime (default on Vercel, free tier is plenty). Needs ABLY_API_KEY.
# Leave REALTIME_DRIVER empty to pick automatically.
REALTIME_DRIVER=
ABLY_API_KEY=

# --- Voice / camera / screen share (WebRTC) --------------------------
# STUN works out of the box. Add a TURN server so calls also work behind strict
# routers, mobile data and office Wi-Fi. Pick ONE provider:
#
# TURN_PROVIDER=cloudflare   1,000 GB / month free, but it may ask for a payment method
#   CF_TURN_KEY_ID=
#   CF_TURN_API_TOKEN=
#
# TURN_PROVIDER=metered      no credit card. The Open Relay page says 20 GB / month, the pricing
#                            page lists 500 MB: check your dashboard after signing up.
#   METERED_APP=yourapp       (the "yourapp" in yourapp.metered.live)
#   METERED_API_KEY=
#
# TURN_PROVIDER=static       any TURN server with a fixed username/password
#   TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
#   TURN_USERNAME=
#   TURN_CREDENTIAL=
#   ExpressTURN free plan (1,000 GB / month, port 3478 only) works here:
#   TURN_URLS=turn:free.expressturn.com:3478?transport=udp,turn:free.expressturn.com:3478?transport=tcp
#
# TURN_PROVIDER=coturn       your own coturn with "use-auth-secret"
#   TURN_URLS=turn:turn.example.com:3478
#   TURN_SECRET=
TURN_PROVIDER=

# --- Optional tuning -------------------------------------------------
# ROOM_IDLE_HOURS=24      temporary rooms disappear after this many idle hours
# CHAT_KEEP_DAYS=7        chat history is deleted after this many days
# STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
